# Copiez ce fichier vers .env et renseignez vos propres valeurs.
# Ne commitez JAMAIS le fichier .env réel.

DISCORD_TOKEN=your_token_here

# ID(s) Discord des propriétaires du bot, séparés par des virgules (optionnel)
OWNER_IDS=

# Préfixe de commandes texte (le bot fonctionne principalement en slash commands)
COMMAND_PREFIX=!

# Niveau de log : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Chemin du fichier SQLite (par défaut: ./afrocodeurs.db)
DATABASE_PATH=afrocodeurs.db

# Valeurs par défaut appliquées lors de /setup (modifiables ensuite via /config)
DEFAULT_WELCOME_ENABLED=true
DEFAULT_TICKETS_ENABLED=true
DEFAULT_PROJECTS_ENABLED=true
DEFAULT_VOICE_ENABLED=false
