[Unit]
Description=AfroCodeurs Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adaptez ces chemins et l'utilisateur à votre VPS
User=afrocodeurs
Group=afrocodeurs
WorkingDirectory=/home/afrocodeurs/afrocodeurs
ExecStart=/home/afrocodeurs/afrocodeurs/venv/bin/python bot.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=afrocodeurs

# Durcissement basique (optionnel mais recommandé)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
