[Unit]
Description=Master Agent Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adaptez ces chemins et l'utilisateur à votre VPS
User=masteragent
Group=masteragent
WorkingDirectory=/home/masteragent/masteragent
ExecStart=/home/masteragent/masteragent/venv/bin/python bot.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=masteragent

# Durcissement basique (optionnel mais recommandé)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
